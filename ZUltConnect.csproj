<Project Sdk="Microsoft.NET.Sdk">

  <!-- Z ULT Connect: control Sony ULT Wear headphones from the Windows tray. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 + access to Windows 10/11 Bluetooth APIs -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ZUltConnect</RootNamespace>
    <AssemblyName>ZUltConnect</AssemblyName>
    <Product>Z ULT Connect</Product>
    <AssemblyTitle>Z ULT Connect</AssemblyTitle>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- keep the installer project and build outputs out of the app build -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Installer\**;publish\**;installer-out\**;tests\**;docs\**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CA1416;CS8618;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="ZUltConnect.app.ico" />
    <!-- 3D animation frames for the screen at the top (made by Assets/render.py) -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="ZUltConnect.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
